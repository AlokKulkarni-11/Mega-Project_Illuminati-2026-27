# Copy this file to .env and fill in real values. Never commit the real .env.

# --- LLM provider for pipeline/marketmind_pipeline.py (default: gemini) ---
GEMINI_API_KEY=your_gemini_key_here          # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=your_anthropic_key_here  # only needed if using --provider anthropic

# Optional overrides (CLI flags take priority over these)
# MARKETMIND_PROVIDER=gemini
# MARKETMIND_MODEL=gemini-3.1-pro-preview

# --- Database (once Postgres is live — sql/V1__init_schema.sql) ---
DB_HOST=localhost
DB_NAME=marketmind
DB_USER=marketmind_app
DB_PASSWORD=change_me
