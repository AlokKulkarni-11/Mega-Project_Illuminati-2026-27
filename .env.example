# Engine Configuration
# ENGINE_MODE: disabled | mock | http
ENGINE_MODE=mock
ENGINE_BASE_URL=http://localhost:8000
MARKETMIND_ENGINE_SCHEMA_ENABLED=false

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:8080/api
