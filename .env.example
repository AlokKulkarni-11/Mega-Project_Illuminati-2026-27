# Database Configuration (PostgreSQL with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketmind
DB_USER=marketmind_user
DB_PASSWORD=marketmind_password
DB_URL=jdbc:postgresql://localhost:5432/marketmind

# JWT Secret (minimum 256-bit secret for HMAC-SHA256)
JWT_SECRET=4f8b92c1e7a3d6f08152b49c3e7a1d5f80b2c4e6a8d0f2a4c6e8b0d2f4a6c8e0
